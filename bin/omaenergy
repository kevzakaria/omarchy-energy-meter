#!/usr/bin/python3
"""Energy accounting for this machine: sample hardware power counters, keep a
permanent daily rollup, and report consumption per day / week / month / year.

WHAT IS MEASURED AND WHAT IS NOT
--------------------------------
Two terms are read from hardware:

  CPU/SoC   RAPL `package-*` energy counters (`/sys/class/powercap/*/energy_uj`).
            A true accumulating energy counter, so its integral is exact at any
            sample interval. On AMD this is MSR C001_029B, the whole socket:
            core complexes plus the I/O die. It does NOT include DIMMs, the
            discrete GPU, or the chipset.
  GPU       amdgpu hwmon `power1_average` (or `power1_input` where that is the
            only one exposed). This is *not* an energy counter: it is a
            firmware-filtered power estimate, reported in whole watts, which
            must be integrated by sampling. Its integral is therefore
            approximate; see GPU SAMPLING below.

Everything else in the box -- DRAM, NVMe, SATA, fans, chipset, USB -- has no
power sensor on a typical desktop board, and the PSU's AC/DC conversion loss is
not observable from inside the machine at all. Those are configuration
constants (`baseline_w`, `psu_efficiency`), i.e. estimates. Expect the reported
total to sit within roughly +/-15-20% of a wall meter, while *trends* are far
better than that, because the part that varies with load is the part that is
genuinely measured.

The estimates are deliberately NOT baked into stored rows. The database holds
only measured microjoules plus the tracked duration, and the constants are
applied at query time -- so recalibrating `baseline_w` or `psu_efficiency`, or
correcting `tariff`, fixes the ENTIRE history rather than only future samples.

WHY THE RAPL `core` ZONE IS IGNORED
-----------------------------------
On Zen, the `core` powercap zone is fed by MSR_AMD_CORE_ENERGY_STATUS, which is
per-core, and powercap reads it on the package's lead CPU only. So the sysfs
`core` file is ONE physical core, not a package aggregate. Measured on a 5950X:
pinning a busy loop to cpu0 raised it by 6.6 W while pinning to cpu8 did not
move it at all, and with 32 threads loaded it read 5.8 W against a package
reading of 130.2 W. It is a subset of `package-0`, so adding the two would
double count that core. Only `package-*` zones are summed.

GPU SAMPLING
------------
Because the GPU term is a power estimate rather than a counter, its energy is
obtained by quadrature, which is only as good as the sample rate. Measured
against a dense 100 ms reference trace on this machine, a trapezoid rule at a
10 s spacing was off by -2.0% at idle and +2.6% under a light load, while 1 s
        spacing was off by -0.39%. Short bursts can alias much worse than that.
The daemon therefore sub-samples the GPU at `gpu_interval_s` (default 1 s) and
integrates those, while still writing one database row per `interval_s`. The
CPU term needs none of this: it is a counter, so a delta over the whole
interval is exact regardless of spacing.

SCOPE
-----
Supported and verified: AMD or Intel CPUs exposing RAPL `package-*`, plus an
optional discrete AMD GPU. Detected but deliberately unused: the Intel `psys`
and `dram` zones (see `omaenergy status`). Using `psys` would be strictly
better than package-plus-estimate, and `dram` would shrink the estimated
remainder, but neither could be verified on real hardware here, and this tool
would rather report a source as unused than integrate a number whose semantics
it has not checked.

On an AMD APU the integrated GPU is already inside the RAPL package figure, and
amdgpu's `power1_average` on an APU is documented to include the CPU. Adding
both would double count nearly the whole machine, so on an APU the GPU term is
dropped and the reason is reported.
"""

from __future__ import annotations

import argparse
import errno
import json
import os
import secrets
import stat
import sqlite3
import sys
import time
from datetime import date, datetime, timedelta
from pathlib import Path

STATE_DIR = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "omarchy-energy"
CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "omarchy-energy"
DB_PATH = STATE_DIR / "energy.db"
CONFIG_PATH = CONFIG_DIR / "config.json"


class UnsafePathError(RuntimeError):
    """A managed path is not the owner-only file or directory we created."""


_DIR_FDS: dict[Path, int] = {}

# A managed file is JSON config or a SQLite database, both kilobytes. This cap
# exists so a file planted at one of those names cannot make us allocate
# whatever its size happens to be before we notice it is not ours.
MAX_MANAGED_BYTES = 1 << 20


def _unsafe(path: Path | str, reason: str) -> UnsafePathError:
    return UnsafePathError(f"refusing to use {path}: {reason}")


def _dir_path(dir_fd: int) -> Path:
    for path, fd in _DIR_FDS.items():
        if fd == dir_fd:
            return path
    return Path(f"/proc/self/fd/{dir_fd}")


def _raise_open(
    path: Path,
    exc: OSError,
    *,
    directory: bool,
    dir_fd: int | None = None,
    name: str | None = None,
) -> None:
    # O_DIRECTORY|O_NOFOLLOW on a symlink returns ENOTDIR on Linux, not ELOOP,
    # because the symlink inode itself is not a directory. Look at the leaf
    # with AT_SYMLINK_NOFOLLOW before picking a reason.
    if dir_fd is not None and name is not None:
        try:
            st = os.stat(name, dir_fd=dir_fd, follow_symlinks=False)
        except OSError:
            st = None
        if st is not None and stat.S_ISLNK(st.st_mode):
            raise _unsafe(path, "is a symbolic link") from None
    if exc.errno == errno.ELOOP:
        raise _unsafe(path, "is a symbolic link") from None
    if directory and exc.errno == errno.ENOTDIR:
        raise _unsafe(path, "is not a directory") from None
    if not directory and exc.errno == errno.EISDIR:
        raise _unsafe(path, "is not a regular file") from None
    raise exc


def _check_owned_dir(st: os.stat_result, path: Path) -> None:
    if not stat.S_ISDIR(st.st_mode):
        raise _unsafe(path, "is not a directory")
    if st.st_uid != os.getuid():
        raise _unsafe(path, f"is owned by uid {st.st_uid}, not uid {os.getuid()}")


def _check_owned_file(st: os.stat_result, path: Path) -> None:
    if stat.S_ISLNK(st.st_mode):
        raise _unsafe(path, "is a symbolic link")
    if not stat.S_ISREG(st.st_mode):
        raise _unsafe(path, "is not a regular file")
    if st.st_uid != os.getuid():
        raise _unsafe(path, f"is owned by uid {st.st_uid}, not uid {os.getuid()}")
    if st.st_nlink != 1:
        # O_NOFOLLOW says nothing about hard links: a second name for this
        # inode is not a symlink, so the open succeeds and every later
        # operation lands on a file we did not create. Measured, not
        # theoretical -- a hard link planted at config.json took the chmod
        # that tightens our own files, silently changing an unrelated file's
        # mode from 0644 to 0600.
        raise _unsafe(path, f"has {st.st_nlink} hard links, not 1")


def managed_dir_fd(path: Path, *, create: bool = True) -> int | None:
    """Return a directory fd for a path we manage, cached for the process.

    The fd is the trust anchor: later opens are dir-relative with O_NOFOLLOW,
    so a symlink planted at `path` after we opened it cannot redirect them.
    The parent is the user's XDG layout (created 0700 via os.makedirs when
    missing); only the last component is the directory we own.
    """
    cached = _DIR_FDS.get(path)
    if cached is not None:
        st = os.fstat(cached)
        _check_owned_dir(st, path)
        if stat.S_IMODE(st.st_mode) != 0o700:
            os.fchmod(cached, 0o700)
        return cached

    parent = path.parent
    name = path.name
    if create:
        os.makedirs(parent, mode=0o700, exist_ok=True)
    # The XDG parent is the user's own layout: /home or ~/.config may
    # legitimately be a symlink, so this open follows symlinks by design.
    # Only the component we manage is opened O_NOFOLLOW, just below.
    parent_flags = os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC
    try:
        parent_fd = os.open(parent, parent_flags)  # trusted-parent-open
    except FileNotFoundError:
        if not create:
            return None
        raise
    except OSError as exc:
        _raise_open(parent, exc, directory=True)
        raise

    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
    child_fd: int | None = None
    try:
        try:
            child_fd = os.open(name, flags, dir_fd=parent_fd)
        except FileNotFoundError:
            if not create:
                return None
            try:
                os.mkdir(name, 0o700, dir_fd=parent_fd)
            except FileExistsError:
                pass
            try:
                child_fd = os.open(name, flags, dir_fd=parent_fd)
            except OSError as exc:
                _raise_open(path, exc, directory=True, dir_fd=parent_fd, name=name)
                raise
        except OSError as exc:
            _raise_open(path, exc, directory=True, dir_fd=parent_fd, name=name)
            raise
        if child_fd is None:
            raise _unsafe(path, "is not a directory")
        st = os.fstat(child_fd)
        _check_owned_dir(st, path)
        if stat.S_IMODE(st.st_mode) != 0o700:
            os.fchmod(child_fd, 0o700)
        _DIR_FDS[path] = child_fd
        held = child_fd
        child_fd = None
        return held
    finally:
        os.close(parent_fd)
        if child_fd is not None:
            os.close(child_fd)


def state_dir_fd(*, create: bool = True) -> int | None:
    return managed_dir_fd(STATE_DIR, create=create)


def config_dir_fd(*, create: bool = True) -> int | None:
    return managed_dir_fd(CONFIG_DIR, create=create)


def managed_stat(dir_fd: int, name: str) -> os.stat_result | None:
    """fstatat with AT_SYMLINK_NOFOLLOW. None if `name` is absent."""
    path = _dir_path(dir_fd) / name
    try:
        st = os.stat(name, dir_fd=dir_fd, follow_symlinks=False)
    except FileNotFoundError:
        return None
    _check_owned_file(st, path)
    return st


def managed_exists(dir_fd: int, name: str) -> bool:
    return managed_stat(dir_fd, name) is not None


def read_managed_file(dir_fd: int, name: str) -> str:
    """Read `name` via O_RDONLY|O_NOFOLLOW, fstat-verified and size-capped."""
    path = _dir_path(dir_fd) / name
    st = managed_stat(dir_fd, name)
    if st is None:
        raise FileNotFoundError(path)
    if st.st_size > MAX_MANAGED_BYTES:
        raise _unsafe(path, f"is larger than {MAX_MANAGED_BYTES} bytes")
    # O_NONBLOCK: a FIFO planted between the stat and the open must not hang.
    flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK
    try:
        fd = os.open(name, flags, dir_fd=dir_fd)
    except FileNotFoundError:
        raise
    except OSError as exc:
        _raise_open(path, exc, directory=False, dir_fd=dir_fd, name=name)
        raise
    try:
        _check_owned_file(os.fstat(fd), path)
        chunks: list[bytes] = []
        total = 0
        while True:
            chunk = os.read(fd, 64 * 1024)
            if not chunk:
                break
            total += len(chunk)
            # The stat above is a promise about the file as it was, not as it
            # is: a writer can keep appending while we read. Cap the stream
            # itself, not only the size we were told about.
            if total > MAX_MANAGED_BYTES:
                raise _unsafe(path, f"is larger than {MAX_MANAGED_BYTES} bytes")
            chunks.append(chunk)
        return b"".join(chunks).decode("utf-8")
    finally:
        os.close(fd)


def write_managed_file(dir_fd: int, name: str, text: str) -> None:
    """Replace `name` inside `dir_fd` without following a symlink.

    The temp file is O_EXCL with an unpredictable name so a pre-planted
    `config.json.tmp` cannot be the write target. The destination is
    re-checked (non-symlink, regular, ours) immediately before renameat
    on the same directory fd; a planted symlink is left untouched.
    """
    path = _dir_path(dir_fd) / name
    before = managed_stat(dir_fd, name)
    flags = os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW | os.O_CLOEXEC
    data = text.encode("utf-8")
    tmp_name: str | None = None
    tmp_fd: int | None = None
    try:
        for _ in range(16):
            candidate = f".{name}.{secrets.token_hex(16)}"
            try:
                tmp_fd = os.open(candidate, flags, 0o600, dir_fd=dir_fd)
                tmp_name = candidate
                break
            except FileExistsError:
                continue
        if tmp_fd is None or tmp_name is None:
            raise OSError(errno.EEXIST, "exclusive temp file", str(path))
        os.fchmod(tmp_fd, 0o600)
        view = memoryview(data)
        while view:
            n = os.write(tmp_fd, view)
            view = view[n:]
        os.fsync(tmp_fd)
        os.close(tmp_fd)
        tmp_fd = None
        after = managed_stat(dir_fd, name)
        if before is not None:
            if after is None or (after.st_dev, after.st_ino) != (before.st_dev, before.st_ino):
                raise _unsafe(path, "changed while it was being written")
        os.replace(tmp_name, name, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
        tmp_name = None
        os.fsync(dir_fd)
    finally:
        if tmp_fd is not None:
            os.close(tmp_fd)
        if tmp_name is not None:
            try:
                os.unlink(tmp_name, dir_fd=dir_fd)
            except OSError:
                pass


def tighten_managed_file(dir_fd: int, name: str, mode: int = 0o600) -> None:
    """fchmod on an O_NOFOLLOW fd. Never chmod by pathname.

    Never call this on an inode SQLite has open in this process: the open and
    close below would drop SQLite's locks on it. See tighten_db_files().
    """
    path = _dir_path(dir_fd) / name
    if managed_stat(dir_fd, name) is None:
        return
    # O_NONBLOCK: a FIFO planted between the stat and the open must not hang.
    flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK
    try:
        fd = os.open(name, flags, dir_fd=dir_fd)
    except FileNotFoundError:
        return
    except OSError as exc:
        _raise_open(path, exc, directory=False, dir_fd=dir_fd, name=name)
        raise
    try:
        st = os.fstat(fd)
        _check_owned_file(st, path)
        if stat.S_IMODE(st.st_mode) != mode:
            os.fchmod(fd, mode)
    finally:
        os.close(fd)


def db_sidecars() -> tuple[str, str]:
    # SQLite names WAL sidecars by appending -wal/-shm, not by changing suffix.
    return "energy.db-wal", "energy.db-shm"


def tighten_db_files(dir_fd: int) -> None:
    """Tighten the database and its sidecars. Only before connect(), never after.

    A POSIX advisory lock is dropped when *any* descriptor for the inode is
    closed, not only the descriptor that took the lock, and the drop is
    process-wide. tighten_managed_file() opens and closes a descriptor of its
    own -- it does that even when the mode already matches -- so running it
    against energy.db or a WAL sidecar while this process has the database
    open unlocks them underneath SQLite without any error being raised.
    Another connection is then free to treat the shared-memory file as unused
    and reset or truncate it while we still have it mapped, and the next
    checkpoint reads a page that no longer has storage behind it and takes
    SIGBUS. That is not theoretical: it crashed the daemon inside
    walIteratorNext during COMMIT (issue #2), and the lock loss reproduces in
    twenty lines against a throwaway database.

    https://www.sqlite.org/howtocorrupt.html#posix_advisory_locks_canceled_by_a_separate_thread_doing_close_

    So the modes are fixed before the connection exists and only verified
    afterwards. Nothing is given up by that ordering: SQLite creates -wal and
    -shm with the database file's own mode, so tightening energy.db first is
    what makes the sidecars 0600 whatever umask we inherited.
    """
    tighten_managed_file(dir_fd, "energy.db")
    for name in db_sidecars():
        tighten_managed_file(dir_fd, name)


def verify_db_modes(dir_fd: int) -> None:
    """Stat the database and sidecars without opening them. Safe while connected."""
    managed_stat(dir_fd, "energy.db")
    for name in db_sidecars():
        managed_stat(dir_fd, name)


def tighten_managed_paths(*, db_files: bool = True) -> None:
    """Owner-only modes on the state/config dirs and the files we put there.

    `db_files=False` is for a caller that already holds the database open;
    tighten_db_files() has the reason. Those files are still stat'd, so a
    planted symlink or hard link is still refused -- only the open, fchmod and
    close are skipped, and that is the part with nothing left to do anyway.
    """
    dir_fd = state_dir_fd(create=False)
    if dir_fd is not None:
        if db_files:
            tighten_db_files(dir_fd)
        else:
            verify_db_modes(dir_fd)
    dir_fd = config_dir_fd(create=False)
    if dir_fd is not None:
        # Not a database inode: nothing in this process holds config.json open
        # across the tighten, so the close here cancels no lock of ours.
        tighten_managed_file(dir_fd, "config.json")


POWERCAP_ROOT = Path("/sys/class/powercap")
HWMON_ROOT = Path("/sys/class/hwmon")
DMI_CHASSIS = Path("/sys/class/dmi/id/chassis_type")

# SMBIOS chassis types that mean "portable". 8 portable, 9 laptop, 10 notebook,
# 11 hand held, 14 sub notebook, 30 tablet, 31 convertible, 32 detachable.
PORTABLE_CHASSIS = {8, 9, 10, 11, 14, 30, 31, 32}

UJ_PER_KWH = 3.6e12  # 1 kWh = 1000 W * 3600 s = 3.6e6 J, and 1 J = 1e6 uJ.

SCHEMA = """
CREATE TABLE IF NOT EXISTS samples (
  ts      INTEGER PRIMARY KEY,  -- unix milliseconds at end of interval
  dt_ms   INTEGER NOT NULL,
  cpu_uj  INTEGER NOT NULL,     -- measured, RAPL package sum
  gpu_uj  INTEGER NOT NULL      -- measured, amdgpu power integrated at gpu_interval_s
);
CREATE TABLE IF NOT EXISTS daily (
  day        TEXT PRIMARY KEY,  -- YYYY-MM-DD, local time
  cpu_uj     INTEGER NOT NULL DEFAULT 0,
  gpu_uj     INTEGER NOT NULL DEFAULT 0,
  tracked_ms INTEGER NOT NULL DEFAULT 0,
  -- Largest single-interval AVERAGE measured DC draw, in milliwatts. This is
  -- not an instantaneous peak: a spike shorter than one interval is averaged
  -- away. Reported as `max_sample_w`, never as "peak".
  peak_mw    INTEGER NOT NULL DEFAULT 0
);
CREATE TABLE IF NOT EXISTS meta (k TEXT PRIMARY KEY, v TEXT NOT NULL);
"""

# Bumped whenever an existing table changes shape. `CREATE TABLE IF NOT EXISTS`
# is silent about a table that already exists with the wrong columns, so the
# version is the only thing standing between a schema change and a database
# that reads as fine and reports nonsense.
SCHEMA_VERSION = 1


class SchemaVersionError(RuntimeError):
    """The database on disk was written by a schema this build cannot read."""



# --------------------------------------------------------------------------
# configuration
# --------------------------------------------------------------------------


def is_portable() -> bool:
    try:
        return int(DMI_CHASSIS.read_text().strip()) in PORTABLE_CHASSIS
    except (OSError, ValueError):
        return False


def default_baseline_w() -> float:
    # The unmeasurable remainder is a different animal on a laptop (one SO-DIMM
    # pair, one M.2, a panel and a radio) than on a desktop (four DIMM slots,
    # several drives, case fans, a chipset). Shipping the desktop figure to
    # laptops would be a large silent error, so the default follows the chassis.
    return 12.0 if is_portable() else 32.0


def defaults() -> dict:
    return {
        "baseline_w": default_baseline_w(),
        # PSU AC->DC efficiency. 80+ Gold sits near 0.90 at typical desktop
        # load and worse at very light load. On a laptop the equivalent loss is
        # the AC adapter's.
        "psu_efficiency": 0.89,
        # Price per kWh, in whatever currency `currency` names. There is no
        # sane universal default for this: electricity is 0.08 in one country
        # and 0.45 in another, so the shipped figure is a placeholder and the
        # UI says so until you set it.
        "tariff": 0.30,
        "currency": "EUR",
        # Money formatting. Leave `currency_symbol` empty to take the symbol
        # from the table below, and `cost_decimals` null to take that
        # currency's natural precision -- 2 where a cent exists, 0 for IDR,
        # JPY, KRW and VND where it does not and "Rp 1234.00" is nonsense.
        "currency_symbol": "",
        "cost_decimals": None,
        "interval_s": 10,
        # GPU power is integrated by quadrature, so this is the rate that
        # actually determines GPU energy accuracy. 1 s measured -0.39% against a
        # dense reference; 10 s measured -2.0%.
        "gpu_interval_s": 1.0,
        # Raw per-sample rows exist only to draw charts; the daily rollup is
        # what is kept forever.
        "raw_retention_days": 30,
        # A RAPL counter reset is indistinguishable from a wrap by arithmetic
        # alone, and a reset yields a delta of nearly the whole counter range --
        # about 6.5 kW over a 10 s interval on this hardware. Any interval
        # implying more package power than this is discarded as a reset.
        "sanity_max_cpu_w": 1000.0,
        # "auto" | "off" | an explicit hwmon path. "off" is the honest setting
        # for a machine whose GPU power this tool cannot read.
        "gpu_source": "auto",
    }


# symbol, decimal places. Anything absent falls back to the code itself as the
# symbol with 2 decimals, which is ugly but never wrong.
CURRENCIES = {
    "EUR": ("€", 2), "USD": ("$", 2), "GBP": ("£", 2), "CHF": ("CHF", 2),
    "SEK": ("kr", 2), "NOK": ("kr", 2), "DKK": ("kr", 2), "PLN": ("zł", 2),
    "CZK": ("Kč", 2), "HUF": ("Ft", 0), "RON": ("lei", 2), "TRY": ("₺", 2),
    "RUB": ("₽", 2), "UAH": ("₴", 2), "ILS": ("₪", 2),
    "IDR": ("Rp", 0), "MYR": ("RM", 2), "SGD": ("S$", 2), "THB": ("฿", 2),
    "PHP": ("₱", 2), "VND": ("₫", 0), "INR": ("₹", 2), "PKR": ("₨", 0),
    "CNY": ("¥", 2), "JPY": ("¥", 0), "KRW": ("₩", 0), "TWD": ("NT$", 2),
    "HKD": ("HK$", 2), "AUD": ("A$", 2), "NZD": ("NZ$", 2), "CAD": ("C$", 2),
    "BRL": ("R$", 2), "MXN": ("$", 2), "ARS": ("$", 2), "CLP": ("$", 0),
    "ZAR": ("R", 2), "NGN": ("₦", 2), "EGP": ("E£", 2), "AED": ("AED", 2),
    "SAR": ("SAR", 2), "QAR": ("QAR", 2),
}


def currency_symbol(cfg: dict) -> str:
    explicit = str(cfg.get("currency_symbol") or "").strip()
    if explicit:
        return explicit
    code = str(cfg.get("currency") or "EUR").upper()
    return CURRENCIES.get(code, (code, 2))[0]


def cost_decimals(cfg: dict) -> int:
    override = cfg.get("cost_decimals")
    if override is not None:
        try:
            return max(0, min(6, int(override)))
        except (TypeError, ValueError):
            pass
    code = str(cfg.get("currency") or "EUR").upper()
    return CURRENCIES.get(code, (code, 2))[1]


def fmt_cost(amount: float, cfg: dict) -> str:
    """`€0.42`, `Rp 1234`. A one-character symbol hugs the number, a word-like
    one takes a space, which is what reads correctly in both conventions."""
    symbol = currency_symbol(cfg)
    body = f"{amount:,.{cost_decimals(cfg)}f}"
    return f"{symbol}{body}" if len(symbol) == 1 else f"{symbol} {body}"


def load_config() -> dict:
    cfg = defaults()
    dir_fd = config_dir_fd(create=False)
    if dir_fd is None:
        return cfg
    try:
        raw = read_managed_file(dir_fd, "config.json")
    except FileNotFoundError:
        return cfg
    try:
        cfg.update(json.loads(raw))
    except (ValueError, OSError) as exc:
        print(f"omaenergy: ignoring unreadable {CONFIG_PATH}: {exc}", file=sys.stderr)
    return cfg


def write_default_config() -> None:
    dir_fd = config_dir_fd(create=True)
    if managed_exists(dir_fd, "config.json"):
        tighten_managed_file(dir_fd, "config.json")
        return
    write_managed_file(dir_fd, "config.json", json.dumps(defaults(), indent=2) + "\n")


# key -> (parser, retroactive?, help). `retroactive` means the change rewrites
# the meaning of history the moment it is saved, because the value is applied
# at query time and nothing derived from it was ever stored. The rest only
# affect sampling from the next daemon start.
SETTABLE = {
    "tariff":             (lambda v: _num(v, 0.0, 1e7), True,
                           "price per kWh"),
    "currency":           (lambda v: _code(v), True,
                           "ISO currency code, e.g. EUR, USD, IDR"),
    "currency_symbol":    (lambda v: str(v).strip(), True,
                           "override the symbol; empty means auto"),
    "cost_decimals":      (lambda v: None if str(v).lower() in ("", "null", "auto")
                           else int(_num(v, 0, 6)), True,
                           "decimal places for money; auto by currency"),
    "baseline_w":         (lambda v: _num(v, 0.0, 2000.0), True,
                           "estimated draw of everything without a sensor"),
    "psu_efficiency":     (lambda v: _num(v, 0.3, 1.0), True,
                           "AC->DC efficiency, 0.3-1.0"),
    "interval_s":         (lambda v: int(_num(v, 2, 3600)), False,
                           "seconds per stored sample"),
    "gpu_interval_s":     (lambda v: _num(v, 0.2, 60.0), False,
                           "GPU sub-sample spacing; sets GPU accuracy"),
    "raw_retention_days": (lambda v: int(_num(v, 1, 3650)), False,
                           "how long per-sample rows are kept"),
    "sanity_max_cpu_w":   (lambda v: _num(v, 50.0, 1e6), False,
                           "package draw above this is a counter reset"),
    "gpu_source":         (lambda v: str(v).strip() or "auto", False,
                           "auto | off | an explicit hwmon path"),
}


def _num(value: object, low: float, high: float) -> float:
    try:
        number = float(str(value).strip().replace(",", "."))
    except (TypeError, ValueError):
        raise ValueError("must be a number") from None
    if not low <= number <= high:
        raise ValueError(f"must be between {low} and {high}")
    return number


def _code(value: object) -> str:
    code = str(value).strip().upper()
    if not code.isalpha() or not 2 <= len(code) <= 5:
        raise ValueError("must be 2-5 letters, e.g. EUR")
    return code


def save_config(updates: dict) -> dict:
    """Merge validated values into the config file, atomically.

    Only keys the user set are written, on top of whatever is already on disk,
    so a config file from an older version keeps working and an unknown key
    someone added by hand is preserved rather than silently dropped.
    """
    dir_fd = config_dir_fd(create=True)
    try:
        on_disk = json.loads(read_managed_file(dir_fd, "config.json"))
        if not isinstance(on_disk, dict):
            raise ValueError("config is not a JSON object")
    except FileNotFoundError:
        on_disk = defaults()
    on_disk.update(updates)
    write_managed_file(
        dir_fd, "config.json",
        json.dumps(on_disk, indent=2, ensure_ascii=False) + "\n",
    )
    return on_disk


def fmt_config_value(value: object) -> str:
    """Human form that `omaenergy config key=<value>` will accept back.

    Unset cost_decimals is stored as JSON null / Python None. Printing that
    as `None` leaks the interpreter and is not a token the parser accepts;
    `auto` is. bool must not fall through to str(True), because bool is a
    subclass of int.
    """
    if value is None:
        return "auto"
    if isinstance(value, bool):
        return "true" if value else "false"
    return str(value)


def cmd_config(args: argparse.Namespace, cfg: dict) -> int:
    if args.pairs:
        updates, retroactive_only = {}, True
        for pair in args.pairs:
            if "=" not in pair:
                print(f"omaenergy: expected key=value, got {pair!r}", file=sys.stderr)
                return 2
            key, _, raw = pair.partition("=")
            key = key.strip()
            if key not in SETTABLE:
                print(f"omaenergy: unknown setting {key!r}. Settable: "
                      f"{', '.join(sorted(SETTABLE))}", file=sys.stderr)
                return 2
            parse, retroactive, _ = SETTABLE[key]
            try:
                updates[key] = parse(raw)
            except (TypeError, ValueError) as exc:
                print(f"omaenergy: {key}: {exc}", file=sys.stderr)
                return 2
            retroactive_only &= retroactive
        cfg = save_config(updates)
        if args.json:
            print(json.dumps({"status": "ok", "updated": updates,
                              "restart_required": not retroactive_only}))
        else:
            for key, value in updates.items():
                print(f"  {key} = {fmt_config_value(value)}")
            print("  applied to the whole history" if retroactive_only else
                  "  run: systemctl --user restart omarchy-energy")
        return 0

    if args.json:
        print(json.dumps({key: cfg.get(key) for key in SETTABLE}, indent=2))
        return 0
    print(f"  {CONFIG_PATH}\n")
    for key in SETTABLE:
        _, retroactive, blurb = SETTABLE[key]
        mark = "" if retroactive else "  (needs a daemon restart)"
        print(f"  {key:20} {fmt_config_value(cfg.get(key)):<12} {blurb}{mark}")
    print(f"\n  example: omaenergy config tariff=0.42 currency=EUR")
    return 0


# --------------------------------------------------------------------------
# sensors
# --------------------------------------------------------------------------


def cpu_has_integrated_gpu() -> bool:
    """True when the CPU is an AMD APU, i.e. its GPU is inside RAPL package.

    AMD names APUs with their graphics in the model string ("AMD Ryzen 7 7840U
    w/ Radeon 780M Graphics"), while desktop CPUs like the 5950X do not mention
    Radeon at all. That string is the cheapest reliable signal available without
    a PCI topology walk.
    """
    try:
        for line in Path("/proc/cpuinfo").read_text().splitlines():
            if line.startswith("model name"):
                return "radeon" in line.lower()
    except OSError:
        pass
    return False


class RaplSensor:
    """Sum of every `package-*` powercap zone, with wrap handling.

    `energy_uj` is a free-running counter that wraps at `max_energy_range_uj`,
    so a delta is taken modulo that range. A wrap is arithmetically
    indistinguishable from a counter reset, which is why the caller also applies
    a plausibility ceiling to the implied power.
    """

    def __init__(self) -> None:
        self.zones: list[tuple[Path, int]] = []
        self.unused: list[tuple[str, str]] = []
        for zone in sorted(POWERCAP_ROOT.glob("*:*")):
            try:
                name = zone.joinpath("name").read_text().strip()
            except OSError:
                continue
            if not name.startswith("package-"):
                # `psys` would be a better total than package+baseline, and
                # `dram` would shrink the estimated remainder. Neither could be
                # verified on real hardware, so they are surfaced as unused
                # rather than silently integrated. `core` is a per-core subset
                # of package; see the module docstring.
                if name in ("psys", "dram"):
                    self.unused.append((name, str(zone)))
                continue
            try:
                rng = int(zone.joinpath("max_energy_range_uj").read_text())
                zone.joinpath("energy_uj").read_text()  # probe readability now
            except (OSError, ValueError):
                continue
            self.zones.append((zone / "energy_uj", rng))
        self._prev: list[int] | None = None

    @property
    def available(self) -> bool:
        return bool(self.zones)

    def delta_uj(self) -> int | None:
        """Energy since the previous call, or None if no delta can be formed."""
        if not self.zones:
            # Never return 0 here. A zero delta is indistinguishable from "the
            # CPU used no energy", which would let the daemon record intervals
            # that silently omit CPU draw while still counting as tracked time.
            return None
        cur = [int(path.read_text()) for path, _ in self.zones]
        prev, self._prev = self._prev, cur
        if prev is None or len(prev) != len(cur):
            return None
        return sum((b - a) % rng for (_, rng), a, b in zip(self.zones, prev, cur))

    def reset(self) -> None:
        self._prev = None


class GpuSensor:
    """An amdgpu power reading, chosen deterministically.

    Selection is by the highest `power1_cap`, never by hwmon index: hwmonN
    numbering follows driver probe order, it changes between boots, and it sorts
    lexicographically so "hwmon10" precedes "hwmon2". On a machine with an
    integrated and a discrete GPU, index order would happily pick the 15 W iGPU
    and silently ignore a 300 W card.
    """

    def __init__(self, cfg: dict) -> None:
        self.path: Path | None = None
        self.label = ""
        self.cap_w = 0.0
        self.skipped_reason = ""
        self.candidates: list[dict] = []

        mode = str(cfg.get("gpu_source", "auto"))
        if mode == "off":
            self.skipped_reason = "disabled by config (gpu_source: off)"
            return

        for hwmon in sorted(HWMON_ROOT.glob("hwmon*")):
            try:
                if hwmon.joinpath("name").read_text().strip() != "amdgpu":
                    continue
            except OSError:
                continue
            # `power1_average` is the filtered SoC/board figure; `power1_input`
            # is the instantaneous one and is the only field some cards expose.
            attr = next((a for a in ("power1_average", "power1_input")
                         if self._readable(hwmon / a)), None)
            if attr is None:
                continue
            cap = self._number(hwmon / "power1_cap")
            self.candidates.append({
                "hwmon": str(hwmon),
                "attr": attr,
                "label": self._text(hwmon / "power1_label"),
                "cap_w": round(cap / 1e6, 1) if cap else 0.0,
            })

        if mode not in ("auto", "off"):
            chosen = next((c for c in self.candidates if c["hwmon"] == mode
                           or c["hwmon"] + "/" + c["attr"] == mode), None)
            if chosen is None:
                self.skipped_reason = f"configured gpu_source not found: {mode}"
                return
        elif not self.candidates:
            self.skipped_reason = "no amdgpu power sensor found"
            return
        else:
            chosen = max(self.candidates, key=lambda c: c["cap_w"])
            if cpu_has_integrated_gpu() and len(self.candidates) == 1:
                # The only GPU is the one inside the CPU package, so RAPL
                # already counted it, and amdgpu's own reading on an APU
                # includes the CPU as well. Counting it would double the
                # machine.
                self.skipped_reason = (
                    "integrated GPU on an AMD APU: already included in the RAPL "
                    "package figure, so counting it again would double count")
                return

        self.path = Path(chosen["hwmon"]) / chosen["attr"]
        self.label = chosen["label"]
        self.cap_w = chosen["cap_w"]

    @staticmethod
    def _readable(path: Path) -> bool:
        try:
            int(path.read_text())
            return True
        except (OSError, ValueError):
            return False

    @staticmethod
    def _number(path: Path) -> float:
        try:
            return float(int(path.read_text()))
        except (OSError, ValueError):
            return 0.0

    @staticmethod
    def _text(path: Path) -> str:
        try:
            return path.read_text().strip()
        except OSError:
            return ""

    @property
    def available(self) -> bool:
        return self.path is not None

    def watts(self) -> float:
        if self.path is None:
            return 0.0
        try:
            return int(self.path.read_text()) / 1e6
        except (OSError, ValueError):
            return 0.0


def describe_sources(cfg: dict) -> dict:
    rapl, gpu = RaplSensor(), GpuSensor(cfg)
    return {
        "cpu_zones": [str(p) for p, _ in rapl.zones],
        "cpu_available": rapl.available,
        "gpu_sensor": str(gpu.path) if gpu.available else None,
        "gpu_label": gpu.label or None,
        "gpu_cap_w": gpu.cap_w or None,
        "gpu_candidates": gpu.candidates,
        "gpu_skipped": gpu.skipped_reason or None,
        "unused_zones": [{"name": n, "path": p} for n, p in rapl.unused],
        "is_apu": cpu_has_integrated_gpu(),
        "chassis": "portable" if is_portable() else "desktop-or-other",
    }


# --------------------------------------------------------------------------
# storage
# --------------------------------------------------------------------------


def gate_schema_version(db: sqlite3.Connection, read_only: bool) -> None:
    """Refuse a database this build cannot read; stamp one it can.

    `PRAGMA user_version` lives in the SQLite header rather than in a row, so
    it survives anything that could happen to the `meta` table and it is read
    without a query that might itself depend on the schema. Version 0 is both
    a brand new file and every database written before this check existed,
    which stamped `meta.schema_version` and then never read it back. Both are
    schema 1, so 0 is stamped rather than migrated.

    A reporting command never writes, so it only refuses; stamping and any
    future migration belong to the daemon that owns the file.
    """
    on_disk = db.execute("PRAGMA user_version").fetchone()[0]
    if on_disk > SCHEMA_VERSION:
        raise SchemaVersionError(
            f"{DB_PATH} is schema {on_disk}, and this build understands "
            f"{SCHEMA_VERSION}. A newer omaenergy wrote it. Upgrade rather "
            f"than downgrade: an older build would not see the change and "
            f"would report against columns that no longer mean what it thinks.")
    if read_only or on_disk == SCHEMA_VERSION:
        return
    db.execute(f"PRAGMA user_version = {SCHEMA_VERSION}")


def _create_empty_owned(dir_fd: int, name: str) -> None:
    path = _dir_path(dir_fd) / name
    flags = os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW | os.O_CLOEXEC
    try:
        fd = os.open(name, flags, 0o600, dir_fd=dir_fd)
    except FileExistsError:
        if managed_stat(dir_fd, name) is None:
            raise _unsafe(path, "vanished while it was being created") from None
        return
    except OSError as exc:
        _raise_open(path, exc, directory=False)
        raise
    try:
        os.fchmod(fd, 0o600)
    finally:
        os.close(fd)


def _verify_db_files(dir_fd: int, *, tighten: bool) -> None:
    if managed_stat(dir_fd, "energy.db") is None:
        raise _unsafe(DB_PATH, "vanished while it was being opened")
    # `tighten` is legal only on the pre-connect call: see tighten_db_files().
    if tighten:
        tighten_db_files(dir_fd)
    else:
        verify_db_modes(dir_fd)


def connect(read_only: bool = False) -> sqlite3.Connection:
    """Open the sampler database, refusing a planted symlink.

    SQLite opens the database by pathname (`sqlite3.connect`) and the WAL
    sidecar names are derived from that pathname, so the database file cannot
    be handed to SQLite as a descriptor. The protection there is that the
    state directory is verified owner-only and held open by descriptor, and
    the database plus its sidecars are verified non-symlink, regular and
    owner-owned through that descriptor immediately before and after the
    connect, with a refusal otherwise. That closes the planted-symlink case;
    it does not make SQLite's own `open()` atomic against a same-uid attacker
    already able to write inside a 0700 directory we own. The daemon
    additionally runs under `ProtectHome=read-only` with
    `ReadWritePaths=%h/.local/share/omarchy-energy %h/.config/omarchy-energy`,
    so for the service the write target is confined regardless; the CLI
    invoked from the widget is not sandboxed.
    """
    if read_only:
        dir_fd = state_dir_fd(create=False)
        if dir_fd is None or not managed_exists(dir_fd, "energy.db"):
            raise FileNotFoundError(DB_PATH)
        # A reporting command must never be able to create or migrate the
        # database the daemon owns, nor take a write lock while the daemon is
        # mid-interval.
        db = sqlite3.connect(f"file:{DB_PATH}?mode=ro", uri=True, timeout=10.0)
        db.execute("PRAGMA busy_timeout = 10000")
        gate_schema_version(db, read_only=True)
        _verify_db_files(dir_fd, tighten=False)
        return db

    dir_fd = state_dir_fd(create=True)
    if not managed_exists(dir_fd, "energy.db"):
        _create_empty_owned(dir_fd, "energy.db")
    # Tighten first and connect second. The reverse order cancels the locks
    # SQLite has just taken; tighten_db_files() has the whole story. An
    # existing 0644 database from an install that predates umask 0077 is still
    # tightened on every start, which is what this call is for -- it has simply
    # moved to the last moment at which opening these inodes is harmless.
    _verify_db_files(dir_fd, tighten=True)
    db = sqlite3.connect(DB_PATH, timeout=10.0)
    db.execute("PRAGMA busy_timeout = 10000")
    db.execute("PRAGMA journal_mode = WAL")  # readers never block the writer
    db.execute("PRAGMA synchronous = NORMAL")
    db.executescript(SCHEMA)
    gate_schema_version(db, read_only=False)
    db.commit()
    _verify_db_files(dir_fd, tighten=False)
    return db


def meta_get(db: sqlite3.Connection, key: str, fallback: str | None = None) -> str | None:
    try:
        row = db.execute("SELECT v FROM meta WHERE k = ?", (key,)).fetchone()
    except sqlite3.Error:
        return fallback
    return row[0] if row else fallback


def meta_set(db: sqlite3.Connection, key: str, value: object) -> None:
    db.execute("INSERT INTO meta(k, v) VALUES(?, ?) "
               "ON CONFLICT(k) DO UPDATE SET v = excluded.v", (key, str(value)))


# --------------------------------------------------------------------------
# daemon
# --------------------------------------------------------------------------


def run_daemon(args: argparse.Namespace) -> int:
    write_default_config()
    cfg = load_config()
    interval = max(2.0, float(cfg["interval_s"]))
    gpu_interval = max(0.2, min(float(cfg["gpu_interval_s"]), interval))
    sanity_max_cpu_w = float(cfg["sanity_max_cpu_w"])
    # An interval longer than this is a suspend, a stall, or a clock jump. The
    # counter cannot be trusted across it, so the interval is dropped rather
    # than recorded as a guess; that shows up honestly as reduced coverage.
    max_interval = max(interval * 4, 60.0)

    rapl = RaplSensor()
    gpu = GpuSensor(cfg)

    if not rapl.available:
        print("omaenergy: no readable RAPL package zone. Install the udev rule "
              "(see README) and make sure you are in the 'wheel' group. "
              "Refusing to record samples with no CPU energy.", file=sys.stderr)
        return 1
    if gpu.available:
        print(f"omaenergy: GPU source {gpu.path} (label {gpu.label or '?'}, "
              f"cap {gpu.cap_w or '?'} W)", file=sys.stderr)
    else:
        print(f"omaenergy: no GPU term: {gpu.skipped_reason}. GPU draw will "
              f"read 0 and is not included in totals.", file=sys.stderr)

    db = connect()
    # Mirrored from PRAGMA user_version, which is authoritative; this row is
    # kept so `meta` stays self-describing for anyone reading the file by hand.
    meta_set(db, "schema_version", SCHEMA_VERSION)
    meta_set(db, "interval_s", interval)          # the EFFECTIVE interval, so
    meta_set(db, "gpu_interval_s", gpu_interval)  # readers judge staleness
    meta_set(db, "daemon_started_ms", int(time.time() * 1000))
    meta_set(db, "gpu_source", str(gpu.path) if gpu.available else "")
    meta_set(db, "gpu_skipped", gpu.skipped_reason)
    db.commit()
    # `db` is open, so the database inodes are off limits here; connect()
    # already tightened them while nothing was locked.
    tighten_managed_paths(db_files=False)

    rapl.delta_uj()  # prime the counter; the first delta is meaningless
    prev_gpu_w = gpu.watts()
    dropped = int(meta_get(db, "dropped_intervals", "0") or 0)
    last_prune = 0.0

    while True:
        # --- integrate the GPU across the interval -----------------------
        # The CPU term is a counter and needs only two reads, but the GPU term
        # is a power estimate, so it is sampled `gpu_interval` apart and
        # trapezoid-integrated. A 10 s trapezoid measured -2.0% against a dense
        # reference on this hardware; 1 s measured -0.39%.
        span_start = time.monotonic()
        deadline = span_start + interval
        sub_prev_t = span_start
        gpu_uj_acc = 0.0
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                break
            time.sleep(min(gpu_interval, remaining))
            now_mono = time.monotonic()
            w = gpu.watts()
            gpu_uj_acc += (prev_gpu_w + w) / 2.0 * (now_mono - sub_prev_t) * 1e6
            prev_gpu_w, sub_prev_t = w, now_mono

        dt = sub_prev_t - span_start

        # --- read the CPU counter over exactly that span -----------------
        try:
            cpu_uj = rapl.delta_uj()
        except OSError as exc:
            print(f"omaenergy: RAPL read failed ({exc}); re-probing", file=sys.stderr)
            rapl = RaplSensor()
            if not rapl.available:
                # Continuing here would write rows with no CPU energy while
                # still advancing tracked time, making later buckets look
                # complete when they are missing the largest measured term.
                print("omaenergy: RAPL is no longer readable; exiting rather "
                      "than recording samples without CPU energy.", file=sys.stderr)
                return 1
            rapl.delta_uj()
            prev_gpu_w = gpu.watts()
            dropped += 1
            with db:
                meta_set(db, "dropped_intervals", dropped)
            continue

        if cpu_uj is None:
            continue

        drop_reason = ""
        if dt <= 0 or dt > max_interval:
            drop_reason = f"{dt:.0f}s interval (suspend, stall or clock jump)"
        else:
            implied_w = cpu_uj / dt / 1e6
            if implied_w > sanity_max_cpu_w:
                # A counter reset reads as a delta of nearly the whole range.
                drop_reason = (f"implausible {implied_w:.0f} W package draw "
                               f"(counter reset, not a wrap)")

        if drop_reason:
            dropped += 1
            print(f"omaenergy: dropped {drop_reason}; {dropped} dropped so far",
                  file=sys.stderr)
            rapl.reset()
            rapl.delta_uj()
            # The next kept interval must not trapezoid against a vertex from
            # before the hole.
            prev_gpu_w = gpu.watts()
            with db:
                meta_set(db, "dropped_intervals", dropped)
            continue

        gpu_uj = int(gpu_uj_acc)
        now_ms = int(time.time() * 1000)
        dt_ms = int(dt * 1000)
        # Measured DC draw only; baseline and PSU loss are applied at query time.
        dc_mw = int((cpu_uj + gpu_uj) / dt / 1000)
        day = datetime.now().astimezone().strftime("%Y-%m-%d")

        # One transaction: a crash can lose an interval but can never count it
        # in `samples` without counting it in `daily`, or the reverse.
        with db:
            db.execute("INSERT OR REPLACE INTO samples(ts, dt_ms, cpu_uj, gpu_uj) "
                       "VALUES(?,?,?,?)", (now_ms, dt_ms, cpu_uj, gpu_uj))
            db.execute(
                """INSERT INTO daily(day, cpu_uj, gpu_uj, tracked_ms, peak_mw)
                   VALUES(?,?,?,?,?)
                   ON CONFLICT(day) DO UPDATE SET
                     cpu_uj     = cpu_uj     + excluded.cpu_uj,
                     gpu_uj     = gpu_uj     + excluded.gpu_uj,
                     tracked_ms = tracked_ms + excluded.tracked_ms,
                     peak_mw    = MAX(peak_mw, excluded.peak_mw)""",
                (day, cpu_uj, gpu_uj, dt_ms, dc_mw))

        if time.monotonic() - last_prune > 3600:
            last_prune = time.monotonic()
            cutoff = now_ms - int(cfg["raw_retention_days"]) * 86400 * 1000
            with db:
                db.execute("DELETE FROM samples WHERE ts < ?", (cutoff,))

        if args.once:
            return 0


# --------------------------------------------------------------------------
# reporting
# --------------------------------------------------------------------------
#
# Every watt and kWh leaving this module is AT-SOCKET: measured DC energy is
# divided by `psu_efficiency`, and the estimated remainder is added in. That
# means the parts always sum to the whole -- `cpu_w + gpu_w + rest_w == watts`
# and `cpu_kwh + gpu_kwh + rest_kwh == kwh` -- which matters because the UI
# draws them as a stacked bar under the total. Raw sensor-side values are
# offered separately as `*_dc_w` for anyone calibrating against a wall meter.


def socket_kwh(cpu_uj: int, gpu_uj: int, tracked_ms: int, cfg: dict) -> float:
    rest_uj = float(cfg["baseline_w"]) * (tracked_ms / 1000.0) * 1e6
    return (cpu_uj + gpu_uj + rest_uj) / UJ_PER_KWH / float(cfg["psu_efficiency"])


def socket_w(dc_w: float, cfg: dict) -> float:
    """One measured component, corrected for PSU loss. No baseline added."""
    return dc_w / float(cfg["psu_efficiency"])


def total_socket_w(cpu_dc_w: float, gpu_dc_w: float, cfg: dict) -> float:
    return (cpu_dc_w + gpu_dc_w + float(cfg["baseline_w"])) / float(cfg["psu_efficiency"])


def boot_time_ms() -> int:
    with open("/proc/uptime") as fh:
        return int((time.time() - float(fh.read().split()[0])) * 1000)


def no_data(cfg: dict, status: str = "no_data") -> dict:
    # Deliberately carries NO live numeric fields. Returning `watts: 0` would
    # let a consumer render absence of measurement as a measurement of zero.
    return {
        "status": status,
        "currency": cfg["currency"],
        "tariff": float(cfg["tariff"]),
        "baseline_w": float(cfg["baseline_w"]),
        "psu_efficiency": float(cfg["psu_efficiency"]),
    }


def cmd_now(args: argparse.Namespace, cfg: dict) -> dict:
    dir_fd = state_dir_fd(create=False)
    if dir_fd is None or not managed_exists(dir_fd, "energy.db"):
        return no_data(cfg)
    db = connect(read_only=True)
    row = db.execute("SELECT ts, dt_ms, cpu_uj, gpu_uj FROM samples "
                     "ORDER BY ts DESC LIMIT 1").fetchone()
    if row is None:
        return no_data(cfg)

    ts, dt_ms, cpu_uj, gpu_uj = row
    age = max(0, int(time.time() - ts / 1000))
    # Judge staleness against the interval the RUNNING daemon recorded, not the
    # config file this process just read: the two differ whenever the config was
    # edited without restarting the daemon.
    effective_interval = float(meta_get(db, "interval_s", cfg["interval_s"]) or cfg["interval_s"])

    status = "ok"
    if not RaplSensor().available:
        status = "no_cpu_sensor"
    elif age > max(30.0, effective_interval * 3):
        status = "stale"

    secs = max(dt_ms / 1000.0, 1e-6)
    cpu_dc = cpu_uj / secs / 1e6
    gpu_dc = gpu_uj / secs / 1e6
    tariff = float(cfg["tariff"])

    today = datetime.now().astimezone().strftime("%Y-%m-%d")
    t_row = db.execute("SELECT cpu_uj, gpu_uj, tracked_ms FROM daily WHERE day = ?",
                       (today,)).fetchone() or (0, 0, 0)
    m_row = db.execute("""SELECT COALESCE(SUM(cpu_uj),0), COALESCE(SUM(gpu_uj),0),
                                 COALESCE(SUM(tracked_ms),0)
                          FROM daily WHERE day LIKE ?""", (today[:7] + "%",)).fetchone()

    boot_ms = boot_time_ms()
    b_row = db.execute("""SELECT COALESCE(SUM(cpu_uj),0), COALESCE(SUM(gpu_uj),0),
                                 COALESCE(SUM(dt_ms),0)
                          FROM samples WHERE ts >= ?""", (boot_ms,)).fetchone()
    oldest = db.execute("SELECT MIN(ts) FROM samples").fetchone()[0]
    # `samples` is pruned, so a boot older than the retention window can only be
    # partially summed. Say so rather than under-reporting silently.
    uptime_truncated = bool(oldest is not None and oldest > boot_ms)

    today_kwh = socket_kwh(*t_row, cfg)
    month_kwh = socket_kwh(*m_row, cfg)
    measured_dc = cpu_dc + gpu_dc
    return {
        "status": status,
        "watts": round(total_socket_w(cpu_dc, gpu_dc, cfg), 1),
        "cpu_w": round(socket_w(cpu_dc, cfg), 1),
        "gpu_w": round(socket_w(gpu_dc, cfg), 1),
        "rest_w": round(socket_w(float(cfg["baseline_w"]), cfg), 1),
        "cpu_dc_w": round(cpu_dc, 1),
        "gpu_dc_w": round(gpu_dc, 1),
        # What fraction of this reading is hardware-measured rather than the
        # baseline constant. The honesty of every other number depends on it.
        "measured_share": round(measured_dc / (measured_dc + float(cfg["baseline_w"])), 3)
        if measured_dc + float(cfg["baseline_w"]) > 0 else 0.0,
        "today_kwh": round(today_kwh, 4),
        "today_cost": round(today_kwh * tariff, cost_decimals(cfg)),
        "month_kwh": round(month_kwh, 4),
        "month_cost": round(month_kwh * tariff, cost_decimals(cfg)),
        "currency": cfg["currency"],
        # Consumers should render money with these rather than inventing a
        # symbol from the code: "0.42E" is what slicing a code gives you.
        "currency_symbol": currency_symbol(cfg),
        "cost_decimals": cost_decimals(cfg),
        "tariff": tariff,
        "baseline_w": float(cfg["baseline_w"]),
        "psu_efficiency": float(cfg["psu_efficiency"]),
        "uptime_kwh": round(socket_kwh(*b_row, cfg), 4),
        "uptime_truncated": uptime_truncated,
        # The live figure is the average over the most recent interval, not an
        # instantaneous reading. Consumers should label it that way.
        "window_s": round(secs, 1),
        "sample_age_s": age,
        "interval_s": effective_interval,
    }


def bucket_key(day: date, gran: str) -> str:
    if gran == "day":
        return day.isoformat()
    if gran == "week":
        y, w, _ = day.isocalendar()
        return f"{y}-W{w:02d}"
    if gran == "month":
        return day.strftime("%Y-%m")
    return day.strftime("%Y")


def bucket_span_hours(key: str, gran: str, now: datetime) -> float:
    """Wall-clock hours in a bucket, truncated at `now` for the current one.

    Bucket edges are built as naive local datetimes and then resolved with
    `.astimezone()`, which attaches the UTC offset in force at that instant.
    Pinning them to `now.tzinfo` instead would stamp today's offset onto every
    past bucket, so the day a DST transition lands on would come out 23 or 25
    hours long and a fully-tracked day would be reported as partial coverage.
    """
    if gran == "day":
        naive = datetime.fromisoformat(key)
        start, end = naive.astimezone(), (naive + timedelta(days=1)).astimezone()
    elif gran == "week":
        year, week = key.split("-W")
        naive = datetime.fromisocalendar(int(year), int(week), 1)
        start, end = naive.astimezone(), (naive + timedelta(days=7)).astimezone()
    elif gran == "month":
        year, month = (int(p) for p in key.split("-"))
        start = datetime(year, month, 1).astimezone()
        end = datetime(year + (month == 12), month % 12 + 1, 1).astimezone()
    else:
        start = datetime(int(key), 1, 1).astimezone()
        end = datetime(int(key) + 1, 1, 1).astimezone()
    return max((min(end, now) - start).total_seconds() / 3600.0, 1e-9)


def cmd_breakdown(args: argparse.Namespace, cfg: dict) -> dict:
    gran = args.command
    dir_fd = state_dir_fd(create=False)
    if dir_fd is None or not managed_exists(dir_fd, "energy.db"):
        return {"status": "no_data", "currency": cfg["currency"], "buckets": []}
    db = connect(read_only=True)
    rows = db.execute("SELECT day, cpu_uj, gpu_uj, tracked_ms, peak_mw "
                      "FROM daily ORDER BY day").fetchall()
    if not rows:
        return {"status": "no_data", "currency": cfg["currency"], "buckets": []}

    agg: dict[str, dict] = {}
    for day_str, cpu_uj, gpu_uj, tracked_ms, peak_mw in rows:
        b = agg.setdefault(bucket_key(date.fromisoformat(day_str), gran),
                           {"cpu_uj": 0, "gpu_uj": 0, "tracked_ms": 0, "peak_mw": 0})
        b["cpu_uj"] += cpu_uj
        b["gpu_uj"] += gpu_uj
        b["tracked_ms"] += tracked_ms
        b["peak_mw"] = max(b["peak_mw"], peak_mw)

    now = datetime.now().astimezone()
    tariff = float(cfg["tariff"])
    eff = float(cfg["psu_efficiency"])
    baseline = float(cfg["baseline_w"])
    out = []
    for key in sorted(agg):
        b = agg[key]
        hours = b["tracked_ms"] / 3600000.0
        kwh = socket_kwh(b["cpu_uj"], b["gpu_uj"], b["tracked_ms"], cfg)
        out.append({
            "label": key,
            "kwh": round(kwh, 4),
            "cost": round(kwh * tariff, cost_decimals(cfg)),
            # Average over the time actually sampled, NOT over the calendar
            # bucket. For a partial bucket the two differ enormously; pair this
            # with `coverage` before drawing any conclusion.
            "avg_w_tracked": round(kwh * 1000 / hours, 1) if hours > 0 else 0.0,
            # Largest single-interval average, so a spike shorter than one
            # interval is averaged away. Never call this a peak.
            "max_sample_w": round((b["peak_mw"] / 1000.0 + baseline) / eff, 1),
            "hours": round(hours, 3),
            "coverage": round(min(1.0, hours / bucket_span_hours(key, gran, now)), 4),
            "cpu_kwh": round(b["cpu_uj"] / UJ_PER_KWH / eff, 4),
            "gpu_kwh": round(b["gpu_uj"] / UJ_PER_KWH / eff, 4),
            "rest_kwh": round(baseline * (b["tracked_ms"] / 1000.0) * 1e6 / UJ_PER_KWH / eff, 4),
        })
    if args.number > 0:
        out = out[-args.number:]
    return {"status": "ok", "currency": cfg["currency"], "tariff": tariff,
            "buckets": out}


def cmd_chart(args: argparse.Namespace, cfg: dict) -> dict:
    dir_fd = state_dir_fd(create=False)
    if dir_fd is None or not managed_exists(dir_fd, "energy.db"):
        return {"status": "no_data", "step_s": 300, "points": []}
    db = connect(read_only=True)
    since = int((time.time() - args.hours * 3600) * 1000)
    # Bucket raw samples so a 24 h window returns a drawable number of points
    # rather than ~8600 of them.
    step = max(60, int(args.hours * 3600 / 288))
    rows = db.execute(
        """SELECT (ts / 1000) / ? AS slot,
                  SUM(cpu_uj + gpu_uj) AS uj,
                  SUM(dt_ms) AS dt_ms
           FROM samples WHERE ts >= ?
           GROUP BY slot ORDER BY slot""", (step, since)).fetchall()
    points = []
    for slot, uj, dt_ms in rows:
        secs = max(dt_ms / 1000.0, 1e-6)
        # Divided by the time actually sampled in the slot, not by `step`, so a
        # partial leading or trailing slot reports the draw it saw instead of a
        # spuriously low average.
        points.append({
            "ts": int(slot * step),
            "w": round(total_socket_w(uj / secs / 1e6, 0.0, cfg), 1),
            "tracked_s": round(secs, 1),
        })
    return {"status": "ok" if points else "no_data", "step_s": step, "points": points}


# --------------------------------------------------------------------------
# human-readable rendering
# --------------------------------------------------------------------------

BLOCKS = "▏▎▍▌▋▊▉█"
NO_SAMPLES = "no samples yet. Is omarchy-energy.service running?"


def bar(fraction: float, width: int = 22) -> str:
    fraction = max(0.0, min(1.0, fraction))
    filled = fraction * width
    whole = int(filled)
    out = "█" * whole
    remainder = filled - whole
    if whole < width and remainder > 0.06:
        out += BLOCKS[min(len(BLOCKS) - 1, int(remainder * len(BLOCKS)))]
    return out.ljust(width)


def fmt_hours(hours: float) -> str:
    if hours < 1:
        return f"{hours * 60:.0f}m"
    return f"{hours:.1f}h" if hours < 10 else f"{hours:.0f}h"


def render_now(data: dict, cfg: dict) -> str:
    if "watts" not in data:
        return NO_SAMPLES
    lines = [
        f"  now      {data['watts']:>7.1f} W    at socket, mean over the last "
        f"{data['window_s']:.0f}s",
        f"           {'':>7}      cpu {data['cpu_w']:.1f} + gpu {data['gpu_w']:.1f} "
        f"+ rest {data['rest_w']:.1f} (estimated)",
        f"           {'':>7}      {data['measured_share'] * 100:.0f}% of this reading "
        f"is hardware-measured",
        f"  today    {data['today_kwh']:>7.3f} kWh  {fmt_cost(data['today_cost'], cfg)}",
        f"  month    {data['month_kwh']:>7.3f} kWh  {fmt_cost(data['month_cost'], cfg)}",
        f"  boot     {data['uptime_kwh']:>7.3f} kWh"
        # True both when sampling began after this boot and when the early part
        # of a long boot has aged out of the raw table. Either way the figure
        # covers less than the boot, which is the only thing worth saying.
        + ("  (partial: not sampled for the whole boot)" if data["uptime_truncated"] else ""),
    ]
    if data["status"] == "stale":
        lines.append(f"  ! last sample {data['sample_age_s']}s ago: daemon may be down")
    elif data["status"] == "no_cpu_sensor":
        lines.append("  ! RAPL unreadable: CPU draw is missing from these totals")
    return "\n".join(lines)


def render_breakdown(data: dict, cfg: dict) -> str:
    if not data["buckets"]:
        return NO_SAMPLES
    top = max(b["kwh"] for b in data["buckets"]) or 1.0
    width = max(len(b["label"]) for b in data["buckets"])
    money = [fmt_cost(b["cost"], cfg) for b in data["buckets"]]
    total = fmt_cost(sum(b["cost"] for b in data["buckets"]), cfg)
    # Money width follows the widest rendered amount, so "Rp 1,234" and "€0.42"
    # both line up instead of one convention breaking the column.
    cw = max(len(m) for m in money + [total] + ["cost"])
    lines = [f"  {'':{width}}  {'kWh':>8}  {'cost':>{cw}}  {'avg':>7}  {'max':>7}",
             f"  {'':{width}}  {'':>8}  {'':>{cw}}  {'tracked':>7}  {'~sample':>7}"]
    for b, amount in zip(data["buckets"], money):
        partial = "" if b["coverage"] >= 0.98 else f"  ({fmt_hours(b['hours'])} tracked)"
        lines.append(
            f"  {b['label']:{width}}  {b['kwh']:>8.3f}  {amount:>{cw}}  "
            f"{b['avg_w_tracked']:>6.0f}W  {b['max_sample_w']:>6.0f}W  "
            f"{bar(b['kwh'] / top)}{partial}")
    lines.append(f"  {'total':{width}}  {sum(b['kwh'] for b in data['buckets']):>8.3f}  "
                 f"{total:>{cw}}")
    return "\n".join(lines)


def render_status(data: dict) -> str:
    lines = []
    for key, value in data.items():
        if isinstance(value, list) and value and isinstance(value[0], dict):
            lines.append(f"  {key}:")
            for item in value:
                lines.append("      " + "  ".join(f"{k}={v}" for k, v in item.items()))
        else:
            lines.append(f"  {key:18} {value}")
    return "\n".join(lines)


# --------------------------------------------------------------------------
# entry point
# --------------------------------------------------------------------------


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="omaenergy",
        description="Energy consumption of this machine, per day / week / month / year.")
    sub = parser.add_subparsers(dest="command", required=True)

    p_daemon = sub.add_parser("daemon", help="run the sampler (systemd user service)")
    p_daemon.add_argument("--once", action="store_true",
                          help="record a single interval and exit")

    sub.add_parser("now", help="live draw plus today, this month and this boot")
    for gran in ("day", "week", "month", "year"):
        p = sub.add_parser(gran, help=f"consumption per {gran}")
        p.add_argument("-n", "--number", type=int,
                       default={"day": 14, "week": 8, "month": 12, "year": 0}[gran],
                       help="how many buckets, newest last (0 = all)")
    p_chart = sub.add_parser("chart", help="power over time, for plotting")
    p_chart.add_argument("--hours", type=float, default=24.0)
    sub.add_parser("status", help="discovered sensors, database and configuration")
    sub.add_parser("currencies",
                   help="currency codes this build knows, with symbol and precision")

    p_config = sub.add_parser(
        "config",
        help="show or change settings such as the price per kWh",
        description="With no arguments, list every setting. Pass key=value "
                    "pairs to change them. Price, currency, baseline and PSU "
                    "efficiency apply to the whole history the moment they "
                    "are saved.")
    p_config.add_argument("pairs", nargs="*", metavar="key=value",
                          help="e.g. tariff=0.42 currency=EUR")

    for name, p in sub.choices.items():
        if name != "daemon":
            p.add_argument("--json", action="store_true", help="machine-readable output")

    args = parser.parse_args(argv)
    # Existing artifacts were created 0755/0644 under umask 0022. Tighten
    # them in place on every start, but only paths we manage and only when
    # we own them. This runs before any command has opened the database,
    # which is the condition tighten_db_files() requires.
    os.umask(0o077)
    tighten_managed_paths()
    cfg = load_config()

    if args.command == "daemon":
        try:
            return run_daemon(args)
        except KeyboardInterrupt:
            return 0

    if args.command == "config":
        return cmd_config(args, cfg)

    if args.command == "currencies":
        # The widget's currency picker is populated from here rather than from a
        # copy of the table in QML: one list, and an unknown code entered by
        # hand still works because `currency_symbol` and `cost_decimals` can be
        # set explicitly.
        rows = [{"code": code, "symbol": symbol, "decimals": decimals}
                for code, (symbol, decimals) in sorted(CURRENCIES.items())]
        if args.json:
            print(json.dumps(rows))
        else:
            for row in rows:
                print(f"  {row['code']}  {row['symbol']:<4} {row['decimals']} dp"
                      f"   {fmt_cost(1234.5, {'currency': row['code']})}")
        return 0

    if args.command == "status":
        data = {
            **describe_sources(cfg),
            "db": str(DB_PATH),
            "config": str(CONFIG_PATH),
            "baseline_w": cfg["baseline_w"],
            "psu_efficiency": cfg["psu_efficiency"],
            "tariff": cfg["tariff"],
            "currency": cfg["currency"],
            "interval_s": cfg["interval_s"],
            "gpu_interval_s": cfg["gpu_interval_s"],
        }
        dir_fd = state_dir_fd(create=False)
        if dir_fd is not None and managed_exists(dir_fd, "energy.db"):
            db = connect(read_only=True)
            data["samples"] = db.execute("SELECT COUNT(*) FROM samples").fetchone()[0]
            data["days"] = db.execute("SELECT COUNT(*) FROM daily").fetchone()[0]
            data["tracking_since"] = db.execute("SELECT MIN(day) FROM daily").fetchone()[0]
            data["dropped_intervals"] = int(meta_get(db, "dropped_intervals", "0") or 0)
            data["daemon_interval_s"] = meta_get(db, "interval_s")
        print(json.dumps(data, indent=2) if args.json else render_status(data))
        return 0

    if args.command == "now":
        data = cmd_now(args, cfg)
        print(json.dumps(data) if args.json else render_now(data, cfg))
        return 0

    if args.command == "chart":
        data = cmd_chart(args, cfg)
        if args.json:
            print(json.dumps(data))
        else:
            for pt in data["points"]:
                stamp = datetime.fromtimestamp(pt["ts"]).astimezone().strftime("%H:%M")
                print(f"  {stamp}  {pt['w']:>6.1f} W  {bar(pt['w'] / 400)}")
        return 0

    data = cmd_breakdown(args, cfg)
    print(json.dumps(data) if args.json else render_breakdown(data, cfg))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except SchemaVersionError as exc:
        print(f"omaenergy: {exc}", file=sys.stderr)
        sys.exit(1)
    except UnsafePathError as exc:
        print(f"omaenergy: {exc}", file=sys.stderr)
        sys.exit(1)
    except BrokenPipeError:
        # `omaenergy currencies | head` closes the pipe while we are still
        # writing. Python would otherwise print a traceback at interpreter
        # shutdown when it flushes stdout, which looks like a crash for what is
        # ordinary shell usage. Redirect the fd so that final flush is a no-op.
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(0)
